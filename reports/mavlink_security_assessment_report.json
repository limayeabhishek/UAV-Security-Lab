        "cryptographic_finding": {
          "id": "ARCH-MAV-001",
          "title": "Absence of Non-Repudiation and Role Separation in Symmetric MAVLink 2 Signing",
          "severity": "MEDIUM (Architectural)",
          "explanation": "MAVLink 2 signing relies on symmetric HMAC-SHA256. Because all authorized nodes (GCS, Telemetry Transceiver, and Companion Computer) possess the identical secret key, a compromise of any single peripheral node (such as an internet-facing companion computer) grants cryptographic ability to sign and execute high-privilege commands as the GCS. Symmetric signatures authenticate channel possession, not granular authorization.",
          "defense_in_depth_remediation": "Implement a companion computer MAVLink firewall / router that operates on an isolated serial channel with a command whitelist, preventing the companion computer from forwarding flight-critical disarm or termination commands regardless of key possession."
        }
      }
